{
  "name": "fastdownloader",
  "version": "0.9.1",
  "desktopName": "fm.bernardo.fastDownloader.desktop",
  "description": "A fast YouTube video/audio downloader in electron.js (and many more websites)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --linux --publish never",
    "build_win": "electron-builder build --win --publish never",
    "build_unix": "electron-builder build --linux --publish never",
    "deploy": "node scripts/deploy.js --win --linux",
    "deploy_win": "node scripts/deploy.js --win",
    "deploy_unix": "node scripts/deploy.js --linux"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BERNARDO31P/fastDownloader.git"
  },
  "keywords": [
    "downloader",
    "youtube",
    "fast",
    "audio",
    "video"
  ],
  "author": "Bernardo de Oliveira <bernardo@bernardo.fm>",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@httptoolkit/browser-launcher": "3.1.0",
    "auto-launch": "5.0.6",
    "electron-updater": "6.8.11",
    "fastest-levenshtein": "1.0.16",
    "terminate": "2.8.0",
    "youtube-sr": "4.3.12",
    "ytmusic-api": "5.3.1"
  },
  "build": {
    "appId": "fm.bernardo.fastDownloader",
    "productName": "FastDownloader",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "**/*",
      "!**/node_modules/@biomejs/**",
      "!**/node_modules/zod/src/**",
      "!**/node_modules/zod/v4/**",
      "!**/node_modules/zod/v4-mini/**",
      "!**/*.map",
      "!scripts/**",
      "!**/*.AppImage.zsync",
      "!README.md",
      "!README_TECHNICAL.md",
      "!app/assets/scss/**"
    ],
    "win": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/ffmpeg.exe",
          "to": "ffmpeg.exe"
        },
        {
          "from": "resources/ffprobe.exe",
          "to": "ffprobe.exe"
        },
        {
          "from": "resources/yt-dlp.exe",
          "to": "yt-dlp.exe"
        },
        {
          "from": "resources/icons/256x256.png",
          "to": "icons/256x256.png"
        },
        {
          "from": "resources/icons/64x64.png",
          "to": "icons/64x64.png"
        }
      ]
    },
    "nsis": {
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": true
    },
    "linux": {
      "syncDesktopName": true,
      "category": "Utility",
      "target": [
        "deb",
        "rpm",
        "tar.gz",
        "pacman"
      ],
      "extraResources": [
        {
          "from": "resources/ffmpeg_linux",
          "to": "ffmpeg_linux"
        },
        {
          "from": "resources/yt-dlp_linux",
          "to": "yt-dlp_linux"
        },
        {
          "from": "resources/icons/256x256.png",
          "to": "icons/256x256.png"
        },
        {
          "from": "resources/icons/64x64.png",
          "to": "icons/64x64.png"
        }
      ],
      "extraFiles": [
        {
          "from": "resources/fm.bernardo.fastDownloader.appdata.xml",
          "to": "usr/share/metainfo/fm.bernardo.fastDownloader.appdata.xml"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BERNARDO31P",
        "repo": "fastDownloader"
      }
    ],
    "toolsets": {
      "appimage": "1.0.3"
    }
  }
}